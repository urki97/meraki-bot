# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=       # obtener con @BotFather
TELEGRAM_CHAT_ID=         # tu chat ID — consultar con /getUpdates tras escribirle al bot

# ── Meta Graph API (Instagram + Facebook) ────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=        # ID de la página de Facebook vinculada

# ── Twitter / X ───────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Redes activas (true/false) ────────────────────────────────────────────────
PUBLISH_INSTAGRAM=true
PUBLISH_FACEBOOK=true
PUBLISH_TWITTER=false    # activar cuando se tengan credenciales

# ── Modo publicación ──────────────────────────────────────────────────────────
DRY_RUN=true             # false cuando tengas credenciales reales

# ── Flujo de aprobación ───────────────────────────────────────────────────────
APPROVAL_WINDOW_HOURS=2
MAX_REGENERATIONS=3

# ── Cloudinary (CDN para imágenes — requerido por Meta Graph API) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Modelos ───────────────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
SDXL_MODEL=stabilityai/sdxl-turbo
