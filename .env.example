# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Meta Graph API (Instagram) ────────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Modo publicación ──────────────────────────────────────────────────────────
# true = simula sin hacer llamadas reales a la API
DRY_RUN=true

# ── Flujo de aprobación ───────────────────────────────────────────────────────
APPROVAL_WINDOW_HOURS=2
MAX_REGENERATIONS=3

# ── Modelos ───────────────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
SDXL_MODEL=stabilityai/sdxl-turbo
