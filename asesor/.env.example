# Copia este fichero a .env y rellena las credenciales.
# El .env real está en .gitignore: nunca se sube al repo.

# ============ CREDENCIALES ============
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAME
TELEGRAM_BOT_TOKEN=123456789:REEMPLAZAME
# Tu ID numérico de Telegram. Si no lo sabes: arranca el bot y mándale /start
TELEGRAM_USER_ID=0

# ============ AGENTE ============
MODEL_ID=claude-fable-5
# low | medium | high | xhigh | max — más effort = más calidad, más latencia
EFFORT=medium
MAX_TOKENS=16000

# ============ WHISPER (voz) ============
WHISPER_MODEL=large-v3
# cuda con GPU; cpu si no tienes (entonces pon WHISPER_COMPUTE=int8)
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
WHISPER_IDIOMA=es

# ============ RUTAS / ZONA HORARIA ============
DB_PATH=/app/data/asesor.db
TZ=Europe/Madrid
